config hnproxy 'main'
	option enabled '1'
	option config_dir '/etc/hnproxy'
	option binary '/usr/bin/hnproxy'

config hnproxy 'web'
	option port '16601'
	option username '666'
	option password '666'
	option safe_url ''
	option enable_https '0'
	option cert_file ''
	option key_file ''

config hnproxy 'ddns'
	option enabled '0'
	option interval '300'
	option ipv4_enabled '1'
	option ipv6_enabled '1'

config hnproxy 'reverse_proxy'
	option enabled '0'

config hnproxy 'socket_proxy'
	option enabled '0'

config hnproxy 'security'
	option enable_waf '0'
	option waf_mode 'detection'